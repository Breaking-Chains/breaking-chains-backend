# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/breaking_chains_db?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="your_super_secret_access_key_change_in_production"
JWT_REFRESH_SECRET="your_super_secret_refresh_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id_from_gcp_console.apps.googleusercontent.com"
